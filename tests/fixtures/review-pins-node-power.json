  ],
  [
   "childModal",
   "Reboot · host1",
   "<div class=\"stepper dialog-rail section-editor\" id=\"hostPower\" data-step=\"0\">\n    <label class=\"dialog-section-picker\">Section<select id=\"hostPower_section\" aria-label=\"Section\" onchange=\"UI.selectSection(\"hostPower\",this.value)\"><option value=\"summary\" selected>Summary</option><option value=\"apps\">What goes down · 0</option><option value=\"volumes\">Volume copies · 0</option></select></label>\n    <div class=\"stepper-head\" role=\"tablist\" aria-label=\"Sections\" aria-orientation=\"vertical\"><button type=\"button\" role=\"tab\" id=\"hostPower-tab-summary\" aria-controls=\"hostPower-pane-summary\" aria-selected=\"true\" tabindex=\"0\" class=\"stepper-chip on\" data-i=\"0\" data-key=\"summary\" onclick=\"UI.selectSection(\"hostPower\",\"summary\")\">Summary</button><button type=\"button\" role=\"tab\" id=\"hostPower-tab-apps\" aria-controls=\"hostPower-pane-apps\" aria-selected=\"false\" tabindex=\"-1\" class=\"stepper-chip\" data-i=\"1\" data-key=\"apps\" onclick=\"UI.selectSection(\"hostPower\",\"apps\")\">What goes down · 0</button><button type=\"button\" role=\"tab\" id=\"hostPower-tab-volumes\" aria-controls=\"hostPower-pane-volumes\" aria-selected=\"false\" tabindex=\"-1\" class=\"stepper-chip\" data-i=\"2\" data-key=\"volumes\" onclick=\"UI.selectSection(\"hostPower\",\"volumes\")\">Volume copies · 0</button></div>\n    <div class=\"stepper-pane\" role=\"tabpanel\" aria-labelledby=\"hostPower-tab-summary\" id=\"hostPower-pane-summary\" data-i=\"0\" data-key=\"summary\"><p class=\"ui-lead\"><b>host1</b> is the only host, so the whole cluster goes down. Homestead stops the apps and VMs below cleanly, without evicting pods, then reboots the host. They start again when it is back.</p><dl class=\"ui-facts\"><div><dt>On the host</dt><dd>1 pod · 0 VMs</dd></div></dl><details class=\"ui-more\" data-disclosure=\"After the request\">\n    <summary>After the request</summary><div class=\"ui-more-body\">Follow it in Recent jobs. Check apps, VMs and storage when the host is back.</div></details></div><div class=\"stepper-pane\" role=\"tabpanel\" aria-labelledby=\"hostPower-tab-apps\" id=\"hostPower-pane-apps\" data-i=\"1\" data-key=\"apps\" hidden><div class=\"ui-empty\">No user Deployments are mapped to this host.</div></div><div class=\"stepper-pane\" role=\"tabpanel\" aria-labelledby=\"hostPower-tab-volumes\" id=\"hostPower-pane-volumes\" data-i=\"2\" data-key=\"volumes\" hidden><div class=\"ui-empty\">No Longhorn replica on this host was found.</div></div>\n    <div class=\"dialog-rail-notice\"><div class=\"f ui-typed\">\n    <label for=\"pw_confirm\">Type <b class=\"mono\">host1</b> to confirm</label>\n    <input id=\"pw_confirm\" autocomplete=\"off\" autocapitalize=\"none\" spellcheck=\"false\" placeholder=\"host1\"\n      data-typed-expect=\"host1\" oninput=\"nodePowerReady()\"></div><label class=\"ui-ack\">\n    <input type=\"checkbox\" id=\"pw_outage\"><span>Reboot anyway: the whole cluster, Homestead too, is offline until it returns</span></label><label class=\"ui-ack\">\n    <input type=\"checkbox\" id=\"pw_data\"><span>Go ahead despite the risk to volume copies</span></label></div>\n    <div class=\"ui-actions stepper-foot\" >\n      <div class=\"ui-actions-start\"><button type=\"button\" class=\"btn\" onclick=\"closeModal()\" data-dialog-dismiss=\"true\">Cancel</button></div><div class=\"ui-actions-end\"><button type=\"button\" class=\"btn danger\" id=\"pw_execute\" onclick=\"nodePower(\"host1\",\"reboot\")\" disabled >Reboot host</button></div></div>\n  </div>"
